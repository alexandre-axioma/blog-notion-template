  }
  .controls__search .pagefind-ui__result-link:hover { color: var(--terracotta); }
  .controls__search .pagefind-ui__result-excerpt mark {
    background: var(--terracotta-soft);
    color: var(--terracotta);
    padding: 1px 3px;
