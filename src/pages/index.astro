  /* ============== STAGGER (entrada coreografada no primeiro paint) ==============
     Elementos com .stagger começam invisíveis com leve translateY.
     JS adiciona .is-in com delay incremental, disparando o transition. */
  .stagger {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity .65s cubic-bezier(.2,.7,.2,1),
      transform .65s cubic-bezier(.2,.7,.2,1);
    will-change: opacity, transform;
  }
  .stagger.is-in {
    opacity: 1;
    transform: translateY(0);
