    --pagefind-ui-tag: var(--terracotta-soft);
    --pagefind-ui-border-width: 0;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-image-border-radius: 2px;
    --pagefind-ui-font: 'Newsreader', serif;
    flex: 1;
    min-width: 0;
  }
  .controls__search .pagefind-ui__form {
    background: transparent !important;
    border: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .controls__search .pagefind-ui__form::before {
