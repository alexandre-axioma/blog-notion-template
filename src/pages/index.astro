     comprimento real de qualquer path nosso (~50-80), cobre com folga;
     o JS depois substitui pelo valor exato via getTotalLength(). */
  .draw-on .hero__note-arrow path,
  .draw-on .hero__taste-arrow path {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
  }
