---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts, categoriesFrom, slugify } from "@/lib/notion";
import type { BlogPost } from "@/lib/notion";

export const prerender = true;

/* ============================================================
   ALTERNATIVA — IMAGEM RETRATO + EXCERPT EM 2 COLUNAS

   A imagem agora ocupa uma coluna fixa à esquerda (~360px) e
   estende-se em altura cobrindo tanto o bloco do hero (título,
   dek, notas) quanto o excerpt do corpo. À direita, o conteúdo
   se divide em duas linhas: hero text em cima, excerpt em duas
   colunas em baixo.

   Estrutura: CSS Grid com grid-template-areas
   ============================================================ */

const DEMO_POSTS: BlogPost[] = [
  {
    id: "demo-arquitetura",
    title: "A arquitetura do tempo livre",
    slug: "arquitetura-do-tempo-livre",
    status: "Published",
    summary: "O tempo que sobra também tem planta baixa. Janelas, corredores, porta dos fundos da semana.",
    category: "Ensaios",
    tags: ["tempo", "rotina"],
    publishedAt: "2026-05-11",
    updatedAt: null,
    link: null,
    wordCount: 1300,
    seoScore: null,
    heroImage: null,
    thumbImage: null,
    coverImage: null,
    html:
      "<p>O tempo livre tem planta baixa. Fui descobrir isso aos trinta, quando percebi que mesmo as horas vagas obedecem a alguma geometria invisível, calada, mas presente.</p>" +
      "<p>Algumas têm pé-direito alto, lugar pra pensar devagar. Outras são corredores estreitos, só servem pra atravessar. Sábado de manhã é a sala maior, onde cabem projetos que não pediram permissão pra existir.</p>" +
      "<p>Comecei a tratar o tempo como espaço, e algo mudou. Em vez de me perguntar o que fazer com as horas, comecei a perguntar onde elas ficam. A planta baixa não é fixa, mas existe.</p>",
    toc: [],
  },
  {
    id: "demo-mochileiro",
    title: "O Guia do Mochileiro das Galáxias",
    slug: "guia-do-mochileiro-das-galaxias",
    status: "Published",
    summary: "Notas marginais de uma releitura. Humor cósmico e a coragem de não levar nada a sério demais.",
    category: "Livros",
    tags: ["adams"],
    publishedAt: "2025-05-15",
    updatedAt: null,
    link: null,
    wordCount: 2400,
    seoScore: null,
    heroImage: null,
    thumbImage: null,
    coverImage: null,
    html: "",
    toc: [],
  },
  {
    id: "demo-cartas",
    title: "Cartas para um futuro engenheiro",
    slug: "cartas-para-um-futuro-engenheiro",
    status: "Published",
    summary: "Coisas que eu queria ter ouvido antes de começar. Escritas como quem escreve para si mesmo, dez anos atrás.",
    category: "Cartas",
    tags: ["carreira", "carta"],
    publishedAt: "2025-11-11",
    updatedAt: null,
    link: null,
    wordCount: 1980,
    seoScore: null,
    heroImage: null,
    thumbImage: null,
    coverImage: null,
    html: "",
    toc: [],
  },
  {
    id: "demo-lento",
    title: "Notas sobre o lento",
    slug: "notas-sobre-o-lento",
    status: "Published",
    summary: "Inventário pessoal de coisas que insistem em demorar, e por que eu quero defendê-las.",
    category: "Pensamentos",
    tags: ["atenção"],
    publishedAt: "2026-04-04",
    updatedAt: null,
    link: null,
    wordCount: 880,
    seoScore: null,
    heroImage: null,
    thumbImage: null,
    coverImage: null,
    html: "",
    toc: [],
  },
  {
    id: "demo-sistemas",
    title: "Pequenos sistemas, grandes hábitos",
    slug: "pequenos-sistemas-grandes-habitos",
    status: "Published",
    summary: "Três rituais minúsculos que carregam o resto do meu dia.",
    category: "Tutorial",
    tags: ["hábitos"],
    publishedAt: "2026-01-22",
    updatedAt: null,
    link: null,
    wordCount: 1540,
    seoScore: null,
    heroImage: null,
    thumbImage: null,
    coverImage: null,
    html: "",
    toc: [],
  },
];

const realPosts = await getPublishedPosts();
const posts = realPosts.length > 0
  ? realPosts
  : (import.meta.env.DEV ? DEMO_POSTS : []);
const [feature, ...rest] = posts;

const categoryNames = categoriesFrom(posts);
const categories = categoryNames.map((name) => ({
  name,
  slug: slugify(name),
  count: posts.filter((p) => slugify(p.category) === slugify(name)).length,
}));

const months = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];

function formatDate(date: string | null): string {
  if (!date) return "";
  const parsed = new Date(`${date.slice(0, 10)}T12:00:00`);
  if (Number.isNaN(parsed.getTime())) return "";
  const day = String(parsed.getDate()).padStart(2, "0");
  return `${day} ${months[parsed.getMonth()]} ${parsed.getFullYear()}`;
}

function readingMinutes(words: number | null): number {
  if (!words) return 1;
  return Math.max(1, Math.round(words / 220));
}

/** Picsum como fallback quando o post não tem Hero/Thumb setados no Notion. */
function picsumImage(slug: string, big = false): string {
  return `https://picsum.photos/seed/${slug}/${big ? "1200/1600" : "900/700"}`;
}

function heroImageFor(post: { slug: string; heroImage?: string | null }): string {
  return post.heroImage ?? picsumImage(post.slug, true);
}

function thumbImageFor(post: { slug: string; thumbImage?: string | null }): string {
  return post.thumbImage ?? picsumImage(post.slug, false);
}

function extractBodyText(html: string | null | undefined, maxWords = 90): string[] {
  if (!html) return [];

  const text = html
    .replace(/<pre[\s\S]*?<\/pre>/gi, " ")
    .replace(/<code[\s\S]*?<\/code>/gi, " ")
    .replace(/<h1\b[\s\S]*?<\/h1>/gi, " ")
    .replace(/<h2\b[\s\S]*?<\/h2>/gi, " ")
    .replace(/<\/(p|li|h[3-6]|blockquote)>/gi, "\n\n")
    .replace(/<br\s*\/?>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&hellip;/g, "…");

  const paras = text
    .split(/\n\n+/)
    .map((p) => p.trim().replace(/\s+/g, " "))
    .filter((p) => p.length > 0);

  const result: string[] = [];
  let usedWords = 0;
  for (const para of paras) {
    const words = para.split(/\s+/);
    if (usedWords + words.length <= maxWords) {
      result.push(para);
      usedWords += words.length;
    } else {
      const remaining = maxWords - usedWords;
      if (remaining > 8) {
        result.push(words.slice(0, remaining).join(" "));
      }
      break;
    }
  }
  return result;
}

const featureBody = feature ? extractBodyText(feature.html, 60) : [];
const featureMinutes = feature ? readingMinutes(feature.wordCount) : 0;

/* Pré-computa os dados de "candidato a featured" pra cada filtro.
   "all" usa o mais recente geral; cada categoria usa o mais recente dela.
   Embutido como JSON num script — o JS lê pra trocar a feature dinamicamente
   quando o usuário muda de filtro. */
type FeatureSnapshot = {
  slug: string;
  title: string;
  summary: string;
  category: string;
  dateFormatted: string;
  readingMin: number;
  imageBig: string;
  body: string[];
  /** True só se este é o post mais recente do blog inteiro.
     Usado pra alternar "acabou de sair" (mais recente absoluto)
     vs "em destaque" (mais recente do filtro, mas não do blog). */
  isLatest: boolean;
};

/* Slug do post mais recente do blog. Como getPublishedPosts() retorna
   ordenado por publishedAt desc, é simplesmente posts[0]. */
const latestSlug = posts[0]?.slug ?? null;

function buildSnapshot(p: BlogPost): FeatureSnapshot {
  return {
    slug: p.slug,
    title: p.title,
    summary: p.summary,
    category: p.category,
    dateFormatted: formatDate(p.publishedAt),
    readingMin: readingMinutes(p.wordCount),
    imageBig: heroImageFor(p),
    body: extractBodyText(p.html, 60),
    isLatest: p.slug === latestSlug,
  };
}

const featuresByView: Record<string, FeatureSnapshot | null> = {
  all: feature ? buildSnapshot(feature) : null,
};
for (const c of categories) {
  const first = posts.find((p) => slugify(p.category) === c.slug) ?? null;
  featuresByView[c.slug] = first ? buildSnapshot(first) : null;
}
---

<BaseLayout title="Blog · Seu Nome" hideFooter>

  <!-- ================== TOPBAR ================== -->
  <header class="topbar shell">
    <a href="/" class="topbar__me">
      <img src="/static/images/avatar.svg" alt="" width="44" height="44" />
      <span class="topbar__me-text">
        <strong>
          seu <span class="topbar__mark">blog<svg class="topbar__underline" viewBox="0 0 80 10" fill="none" aria-hidden="true">
            <path d="M2 6 Q 14 2, 26 5 T 50 5 T 74 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>
          </svg></span>
        </strong>
        <em>blog</em>
      </span>
    </a>

    <nav class="topbar__links" aria-label="Outros lugares">
      <a href="/about">sobre</a>
      <a href="https://www.youtube.com/@seucanal" target="_blank" rel="noopener noreferrer">
        yt
        <svg class="topbar__play" width="15" height="11" viewBox="0 0 15 11" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
          <path d="M2.4 0 H 12.6 A 2.4 2.4 0 0 1 15 2.4 V 8.6 A 2.4 2.4 0 0 1 12.6 11 H 2.4 A 2.4 2.4 0 0 1 0 8.6 V 2.4 A 2.4 2.4 0 0 1 2.4 0 Z M 5.8 3 L 10.5 5.5 L 5.8 8 Z"/>
        </svg>
      </a>
    </nav>
  </header>

  {feature ? (
    <>
      <!-- ================== CONTROLS (filtros + busca) ================== -->
      <section class="controls shell">
        <nav class="controls__filters" role="tablist" aria-label="Filtrar por categoria">
          <button class="filter is-active" type="button" data-filter="all">
            tudo<sup class="filter__count">{posts.length}</sup>
          </button>
          {categories.map((c) => (
            <>
              <span class="filter-sep" aria-hidden="true">·</span>
              <button class="filter" type="button" data-filter={c.slug}>
                {c.name.toLowerCase()}<sup class="filter__count">{c.count}</sup>
              </button>
            </>
          ))}
        </nav>

        <div class="controls__search">
          <button class="controls__search-trigger" type="button" aria-expanded="false" aria-controls="search-panel">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5"/>
              <path d="M20 20l-4.5-4.5"/>
            </svg>
            <span>buscar</span>
          </button>
          <div class="controls__search-panel" id="search-panel">
            <div id="search" class="controls__search-inner">
              <span class="controls__search-icon" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <circle cx="10.5" cy="10.5" r="6.5"/>
                  <path d="M20 20l-4.5-4.5"/>
                </svg>
              </span>
              <input class="controls__search-fallback" type="search" placeholder="buscar nas notas…" aria-label="Buscar pelos posts" />
            </div>
            <button class="controls__search-close" type="button" aria-label="Fechar busca">×</button>
          </div>
        </div>
      </section>

      <!-- ================== FEATURE (image + hero + excerpt) ================== -->
      <section class="feature shell" data-slug={feature.slug}>
        <div class="feature__grid">
          <a class="feature__media stagger" data-stagger="0" href={`/${feature.slug}/`} aria-label={feature.title}>
            <img src={heroImageFor(feature)} alt="" loading="eager" />
          </a>

          <div class="feature__hero">
            <p class="hero__meta stagger" data-stagger="1">
              <span class="hero__cat">{feature.category}</span>
              <span class="hero__sep" aria-hidden="true">·</span>
              <span class="hero__date">{formatDate(feature.publishedAt)}</span>
              <span class="hero__sep" aria-hidden="true">·</span>
              <span class="hero__reading">{featureMinutes} min de leitura</span>
            </p>

            <h2 class="hero__title stagger" data-stagger="2">
              <a href={`/${feature.slug}/`}>{feature.title}</a>
            </h2>

            <p class="hero__dek stagger" data-stagger="3">{feature.summary}</p>

            <a class="hero__note draw-on" href={`/${feature.slug}/`} aria-hidden="true" tabindex="-1">
              <svg viewBox="0 0 80 24" fill="none" class="hero__note-arrow">
                <path d="M3 16 Q 18 4, 36 12 T 70 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>
                <path d="M65 4 L 72 8 L 66 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
              <span>acabou de sair</span>
            </a>

            <a class="hero__taste draw-on" href={`/${feature.slug}/`} aria-hidden="true" tabindex="-1">
              <svg viewBox="0 0 32 24" fill="none" class="hero__taste-arrow">
                <path d="M3 4 Q 14 4, 19 18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>
                <path d="M14 13 L 19 19 L 25 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
              <span>um gostinho</span>
            </a>
          </div>

          {featureBody.length > 0 && (
            <a class="feature__excerpt stagger" data-stagger="4" href={`/${feature.slug}/`} aria-label={`Ler ${feature.title}`}>
              {featureBody.map((para, i) => (
                <p class={i === 0 ? "excerpt__para excerpt__para--drop" : "excerpt__para"}>{para}</p>
              ))}
            </a>
          )}
        </div>
      </section>

      {rest.length > 0 && (
        <section class="garden shell" aria-label="Outras notas">
          <header class="garden__head">
            <h2>também por aqui</h2>
          </header>

          <div class="notes">
            {rest.map((p, i) => {
              const minutes = readingMinutes(p.wordCount);
              /* Começa em --right pra contrastar com o hero (imagem à
                 esquerda). Sem isso, a primeira note ecoa o hero e o
                 zig-zag perde o gesto. */
              const side = i % 2 === 0 ? "note--right" : "note--left";
              return (
                <article class={`note ${side}`} data-category={slugify(p.category) || ""} data-slug={p.slug}>
                  <a href={`/${p.slug}/`} class="note__link">
                    <div class="note__media">
                      <img src={thumbImageFor(p)} alt="" loading="lazy" />
                    </div>

                    <div class="note__text">
                      <p class="note__meta">
                        {p.category && <span class="note__cat">{p.category}</span>}
                        {p.publishedAt && (
                          <>
                            <span class="note__sep" aria-hidden="true">·</span>
                            <span>{formatDate(p.publishedAt)}</span>
                          </>
                        )}
                        {minutes > 0 && (
                          <>
                            <span class="note__sep" aria-hidden="true">·</span>
                            <span>{minutes} min</span>
                          </>
                        )}
                      </p>
                      <h3 class="note__title">{p.title}</h3>
                      {p.summary && <p class="note__dek">{p.summary}</p>}
                    </div>
                  </a>
                </article>
              );
            })}
          </div>

          <div class="filter-empty" hidden>
            <p>nada nessa categoria ainda.</p>
          </div>
        </section>
      )}

      <footer class="signoff shell">
        <p>
          todo mundo precisa construir as próprias coisas.
          <br/>
          <span class="signoff__hand">seu nome, escrevendo no caminho</span>
        </p>
      </footer>
    </>
  ) : (
    <section class="empty shell">
      <svg class="empty__ornament" viewBox="0 0 96 18" fill="none" aria-hidden="true">
        <path d="M2 9 Q 18 2, 34 9 T 66 9 T 94 9" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
        <circle cx="48" cy="9" r="2.4" fill="currentColor" />
      </svg>
      <h2 class="empty__title">esse blog ainda está <em>em branco.</em></h2>
      <p>volte daqui a pouco.</p>
    </section>
  )}

</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script src="/pagefind/pagefind-ui.js" is:inline defer></script>

<script id="features-data" type="application/json" is:inline set:html={JSON.stringify(featuresByView)}></script>
<script is:inline>
  function setupHome() {
    const filters = document.querySelectorAll(".filter");
    const notes = document.querySelectorAll(".note");
    const filterEmpty = document.querySelector(".filter-empty");
    const feature = document.querySelector(".feature");
    const garden = document.querySelector(".garden");

    const prefersReducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* === Efeito premium 1: Stagger no primeiro paint ===
       Elementos com .stagger começam invisíveis (CSS). Aqui adicionamos
       .is-in com delay incremental baseado em data-stagger. */
    function startStagger() {
      const staggers = document.querySelectorAll(".stagger");
      if (prefersReducedMotion) {
        staggers.forEach((el) => el.classList.add("is-in"));
        return;
      }
      staggers.forEach((el) => {
        const idx = parseInt(el.dataset.stagger || "0", 10);
        /* 60ms inicial deixa o browser pintar o estado base antes da
           transição começar. 110ms entre cada dá sensação coreografada
           sem ser lento. */
        setTimeout(() => el.classList.add("is-in"), 60 + idx * 110);
      });
    }

    /* === Efeito premium 2: Marginalia se desenhando ===
       Paths começam invisíveis via CSS (stroke-dasharray: 200, offset: 200,
       sem flash). Aqui mediro o comprimento real e refino, depois animo
       quando o elemento entra na viewport. */
    function setupDrawOn() {
      const items = document.querySelectorAll(".draw-on");
      if (prefersReducedMotion) return;

      items.forEach((item) => {
        const paths = item.querySelectorAll("svg path");
        paths.forEach((path) => {
          const len = path.getTotalLength();
          path.style.strokeDasharray = String(len);
          path.style.strokeDashoffset = String(len);
        });
        const span = item.querySelector("span");
        if (span) span.style.opacity = "0";
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const paths = entry.target.querySelectorAll("svg path");
          paths.forEach((path, i) => {
            /* Path 1 (curva) em 0ms, path 2 (seta) em 250ms. 800ms
               cobre o gesto inteiro sem se arrastar. */
            path.style.transition = `stroke-dashoffset 800ms cubic-bezier(.2,.7,.2,1) ${i * 250}ms`;
            requestAnimationFrame(() => {
              path.style.strokeDashoffset = "0";
            });
          });
          const span = entry.target.querySelector("span");
          if (span) {
            const labelDelay = (paths.length - 1) * 250 + 500;
            span.style.transition = `opacity 400ms ease ${labelDelay}ms`;
            requestAnimationFrame(() => {
              span.style.opacity = "1";
            });
          }
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.4 });

      items.forEach((item) => observer.observe(item));
    }

    startStagger();
    setupDrawOn();

    /* Rede de segurança: se alguma animação travar ou observer não
       disparar, força os elementos pra o estado final após 2.5s.
       Garante que a página nunca termine quebrada. */
    setTimeout(() => {
      document.querySelectorAll(".stagger:not(.is-in)").forEach((el) => {
        el.classList.add("is-in");
      });
      document.querySelectorAll(".draw-on svg path").forEach((path) => {
        if (path.style.strokeDashoffset !== "0") {
          path.style.transition = "stroke-dashoffset 400ms ease";
          path.style.strokeDashoffset = "0";
        }
      });
      document.querySelectorAll(".draw-on span").forEach((span) => {
        span.style.opacity = "1";
      });
    }, 2500);

    /* === Toggle da busca colapsável (variação B) === */
    const searchTrigger = document.querySelector(".controls__search-trigger");
    const searchPanel = document.querySelector(".controls__search-panel");
    const searchClose = document.querySelector(".controls__search-close");

    /* Wrapper que recebe a classe .is-open. Trigger e panel ficam absolutos
       dentro dele e alternam via opacity/transform — transição suave em vez
       do swap binário com `hidden`. */
    const searchWrap = document.querySelector(".controls__search");

    function openSearch() {
      if (!searchWrap || !searchPanel) return;
      searchWrap.classList.add("is-open");
      if (searchTrigger) searchTrigger.setAttribute("aria-expanded", "true");
      /* Aguarda a transição antes de focar pra não interromper o fade */
      setTimeout(() => {
        const input = searchPanel.querySelector("input");
        if (input) input.focus();
      }, 200);
    }
    function closeSearch() {
      if (!searchWrap) return;
      searchWrap.classList.remove("is-open");
      if (searchTrigger) {
        searchTrigger.setAttribute("aria-expanded", "false");
        searchTrigger.focus();
      }
    }
    if (searchTrigger) searchTrigger.addEventListener("click", openSearch);
    if (searchClose)   searchClose.addEventListener("click", closeSearch);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && searchWrap && searchWrap.classList.contains("is-open")) closeSearch();
    });

    /* Snapshot pré-computado de qual post vira "featured" pra cada filtro.
       JSON embutido no HTML pelo Astro. Estrutura: { all: {...}, cartas: {...}, ... } */
    let featuresByView = {};
    try {
      const dataEl = document.getElementById("features-data");
      if (dataEl) featuresByView = JSON.parse(dataEl.textContent || "{}");
    } catch (e) { /* JSON inválido — segue com objeto vazio */ }

    /* Preload das imagens dos featureds de cada categoria assim que
       a página carrega. Quando o usuário trocar o filtro, a imagem
       já estará no cache do browser e a troca é instantânea. */
    Object.values(featuresByView).forEach((snap) => {
      if (snap && snap.imageBig) {
        const img = new Image();
        img.src = snap.imageBig;
      }
    });

    /* Fade-out → swap de conteúdo → fade-in, em vez de troca seca.
       Timeout casa com a duração da transition do .feature (220ms). */
    function applyFeature(snapshot) {
      if (!feature) return;

      const doUpdate = () => {
        if (!snapshot) {
          feature.hidden = true;
          feature.classList.remove("is-swapping");
          return;
        }
        feature.hidden = false;
        feature.dataset.slug = snapshot.slug;

        /* Imagem + link */
        const mediaLink = feature.querySelector(".feature__media");
        const mediaImg = feature.querySelector(".feature__media img");
        if (mediaLink) {
          mediaLink.setAttribute("href", `/${snapshot.slug}/`);
          mediaLink.setAttribute("aria-label", snapshot.title);
        }
        if (mediaImg) mediaImg.setAttribute("src", snapshot.imageBig);

        /* Meta */
        const cat = feature.querySelector(".hero__cat");
        const date = feature.querySelector(".hero__date");
        const reading = feature.querySelector(".hero__reading");
        if (cat) cat.textContent = snapshot.category;
        if (date) date.textContent = snapshot.dateFormatted;
        if (reading) reading.textContent = `${snapshot.readingMin} min de leitura`;

        /* Título */
        const titleLink = feature.querySelector(".hero__title a");
        if (titleLink) {
          titleLink.textContent = snapshot.title;
          titleLink.setAttribute("href", `/${snapshot.slug}/`);
        }

        /* Marginalia "acabou de sair" e "um gostinho" também levam pro post.
           O texto do primeiro alterna: "acabou de sair" só se for o post
           mais recente do blog; "em destaque" caso contrário (mais recente
           da categoria filtrada, mas não do blog inteiro). */
        const noteLink = feature.querySelector(".hero__note");
        if (noteLink) noteLink.setAttribute("href", `/${snapshot.slug}/`);
        const noteSpan = feature.querySelector(".hero__note span");
        if (noteSpan) noteSpan.textContent = snapshot.isLatest ? "acabou de sair" : "em destaque";
        const tasteLink = feature.querySelector(".hero__taste");
        if (tasteLink) tasteLink.setAttribute("href", `/${snapshot.slug}/`);

        /* Dek */
        const dek = feature.querySelector(".hero__dek");
        if (dek) dek.textContent = snapshot.summary || "";

        /* Excerpt — reconstrói os parágrafos com drop cap no primeiro */
        const excerpt = feature.querySelector(".feature__excerpt");
        if (excerpt) {
          excerpt.setAttribute("href", `/${snapshot.slug}/`);
          excerpt.setAttribute("aria-label", `Ler ${snapshot.title}`);
          const body = Array.isArray(snapshot.body) ? snapshot.body : [];
          excerpt.innerHTML = body.map((para, i) => {
            const cls = i === 0 ? "excerpt__para excerpt__para--drop" : "excerpt__para";
            /* Escape básico pra evitar HTML injection */
            const safe = String(para)
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;");
            return `<p class="${cls}">${safe}</p>`;
          }).join("");
          excerpt.hidden = body.length === 0;
        }

        /* Fade-in (próximo frame pra browser pintar com opacidade 0 antes) */
        requestAnimationFrame(() => feature.classList.remove("is-swapping"));
      };

      feature.classList.add("is-swapping");
      /* 200ms casa com transition do .feature; menos que isso pisca,
         mais que isso atrasa demais a percepção de resposta. */
      setTimeout(doUpdate, 200);
    }

    filters.forEach((filterBtn) => {
      filterBtn.addEventListener("click", () => {
        const filter = filterBtn.dataset.filter;
        filters.forEach((f) => f.classList.toggle("is-active", f === filterBtn));

        /* 1. Atualiza o featured pro novo "mais recente" da categoria */
        const snapshot = featuresByView[filter] || null;
        applyFeature(snapshot);
        const featuredSlug = snapshot ? snapshot.slug : null;

        /* 2. Filtra notes: esconde as que não batem na categoria E a note
           cujo slug virou o featured (pra não duplicar acima e abaixo).
           Recomputa a alternância left/right baseada nos itens visíveis
           pra manter o zig-zag consistente após o filtro. */
        let visible = 0;
        notes.forEach((note) => {
          const matchesCategory = filter === "all" || note.dataset.category === filter;
          const isFeatured = note.dataset.slug === featuredSlug;
          note.hidden = !matchesCategory || isFeatured;
          if (!note.hidden) {
            /* Primeiro visível em --right pra contrastar com hero */
            note.classList.toggle("note--right", visible % 2 === 0);
            note.classList.toggle("note--left",  visible % 2 === 1);
            visible += 1;
          }
        });

        /* 3. Esconde o garden se não sobrou nada na lista (mantém só o featured) */
        if (garden) garden.hidden = visible === 0;
        if (filterEmpty) filterEmpty.hidden = visible > 0 || !!snapshot;
      });
    });

    let attempts = 0;
    function tryPagefind() {
      if (typeof PagefindUI === "undefined") {
        if (++attempts < 60) setTimeout(tryPagefind, 50);
        return;
      }
      const search = document.querySelector("#search");
      if (!search) return;
      if (search.querySelector(".pagefind-ui__form")) return;
      const icon = search.querySelector(".controls__search-icon");
      if (icon) icon.remove();
      const fallback = search.querySelector(".controls__search-fallback");
      if (fallback) fallback.remove();
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: "buscar nas notas…",
          clear_search: "limpar",
          load_more: "mostrar mais",
          search_label: "Buscar pelos posts",
          filters_label: "Filtros",
          zero_results: 'Nada encontrado pra "[SEARCH_TERM]".',
          many_results: '[COUNT] resultados pra "[SEARCH_TERM]".',
          one_result: '1 resultado pra "[SEARCH_TERM]".',
          alt_search: 'Nada encontrado pra "[SEARCH_TERM]". Mostrando "[DIFFERENT_TERM]".',
          search_suggestion: 'Nada encontrado pra "[SEARCH_TERM]". Tente: [DIFFERENT_TERMS].',
          searching: "buscando…",
        },
      });
    }
    tryPagefind();
  }

  document.addEventListener("astro:page-load", setupHome);
</script>

<style is:global>
  .feature.shell,
