  }

  /* === Pagefind UI dentro do panel === */
  .controls__search #search {
    --pagefind-ui-scale: 0.72;
    --pagefind-ui-primary: var(--terracotta);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: transparent;
